# Copy to .env.prod and fill in real values. NEVER commit .env.prod.
# Generate secrets with:  openssl rand -base64 32

# Your DuckDNS (or other) domain, WITHOUT any subdomain prefix.
# The stack serves app.<DOMAIN>, api.<DOMAIN>, id.<DOMAIN>.
DOMAIN=yourname.duckdns.org

# Docker Hub username the images are published under.
DOCKERHUB_USER=youssefhikal

POSTGRES_PASSWORD=change-me
MONGO_PASSWORD=change-me
RABBITMQ_USER=mazad
RABBITMQ_PASSWORD=change-me

# OIDC client secret shared between IdentityService and the Next.js app.
CLIENT_SECRET=change-me

# NextAuth session encryption secret (openssl rand -base64 32).
AUTH_SECRET=change-me
